{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "curly": "warn",
    "eqeqeq": "warn",
    "no-throw-literal": "warn",
    "no-underscore-dangle": [
      "warn",
      {
        "allow": ["_onDidChangeTreeData"]
      }
    ],
    "typescript/no-floating-promises": "error"
  },
  "options": {
    "typeAware": true
  }
}
